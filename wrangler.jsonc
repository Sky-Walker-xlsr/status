    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJsYWpmcXNvc3duZmJlc21qcXR2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkzNDE4MDYsImV4cCI6MjEwNDkxNzgwNn0.f9i6FoIIqW1h4r8USVXiYg2P9Ccs-YjUkwc3TZdB3sM"
